# Copy this file to .env and fill in real values. Never commit .env itself.

# While developing, SQLite is fine — zero setup, it's just a file on disk.
DATABASE_URL=sqlite:///./portfolio.db

# When you deploy, switch to Postgres, e.g.:
# DATABASE_URL=postgresql://username:password@localhost:5432/portfolio_db

# Used to sign admin login tokens (JWT). Generate a real one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_real_secret

# Admin login (used to seed the first admin user)
ADMIN_USERNAME=sugam
ADMIN_PASSWORD=changeme_pick_a_strong_password

# Optional: Backblaze B2 for persistent image storage in production.
# Leave all of these blank for local development — uploads will save
# to local disk instead, which is fine for testing on your own machine.
# On Render (or any host with non-persistent disk), these ARE required,
# otherwise uploaded photos disappear whenever the server restarts.
# B2's free tier (10GB, forever) needs no credit card.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT_URL=
